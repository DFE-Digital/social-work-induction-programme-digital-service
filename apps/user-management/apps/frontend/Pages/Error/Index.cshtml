@page
@model ErrorModel

@if (!string.IsNullOrWhiteSpace(Model.PartialName))
{
    <partial name="@Model.PartialName"/>
}
else
{
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">@Model.Title</h1>
        </div>
    </div>
}
